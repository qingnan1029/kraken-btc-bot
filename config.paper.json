{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "kraken-btcusd-paper",
  "strategy": "BtcUsdSmaCross",
  "timeframe": "4h",
  "trading_mode": "spot",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "max_open_trades": 1,
  "stake_currency": "USD",
  "stake_amount": 99.20,
  "tradable_balance_ratio": 0.99,
  "fee": 0.008,
  "ignore_buying_expired_candle_after": 600,
  "fiat_display_currency": "",
  "initial_state": "running",
  "force_entry_enable": false,
  "dataformat_ohlcv": "json",
  "exchange": {
    "name": "kraken",
    "key": "",
    "secret": "",
    "pair_whitelist": ["BTC/USD"],
    "pair_blacklist": []
  },
  "pairlists": [{"method": "StaticPairList"}],
  "order_types": {
    "entry": "market",
    "exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "internals": {"process_throttle_secs": 15}
}
